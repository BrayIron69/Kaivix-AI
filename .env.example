GROQ_API_KEY=
MODEL=
MAX_TOKENS=
TEMPERATURE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL this deployment is actually reachable at (no trailing slash).
# Used to build the Google OAuth redirect_uri
# (scheduling/google_calendar_provider.py). Defaults to
# http://localhost:8000 for local dev if unset -- set this to the real
# deployment URL (e.g. https://kaivix-ai.onrender.com) in production.
PUBLIC_BASE_URL=

# HTTP Basic Auth credentials for the admin lead dashboard
# (api/routers/admin.py, served at <PUBLIC_BASE_URL>/admin).
# There is no default and no fallback: if either value is unset, every
# /admin route returns 503 and the dashboard is inaccessible. Set both to
# real values in the deployment environment -- do not commit them.
ADMIN_USERNAME=
ADMIN_PASSWORD=
