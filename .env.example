GROQ_API_KEY=
MODEL=
MAX_TOKENS=
TEMPERATURE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL this deployment is actually reachable at (no trailing slash).
# Used to build the Google OAuth redirect_uri
# (scheduling/google_calendar_provider.py). Defaults to
# http://localhost:8000 for local dev if unset -- set this to the real
# deployment URL (e.g. https://kaivix-ai.onrender.com) in production.
PUBLIC_BASE_URL=

# HTTP Basic Auth credentials for the admin lead dashboard
# (api/routers/admin.py, served at <PUBLIC_BASE_URL>/admin).
# There is no default and no fallback: if either value is unset, every
# /admin route returns 503 and the dashboard is inaccessible. Set both to
# real values in the deployment environment -- do not commit them.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Lets scheduling/render_env_sync.py persist the Google Calendar OAuth
# refresh_token into GOOGLE_CALENDAR_REFRESH_TOKENS on Render after each
# /oauth/google/connect, so a connected calendar survives a redeploy
# (Render has no persistent disk -- calendar_tokens.db alone does not
# survive one, the same gap BUSINESS_API_KEYS closed for API keys).
#
# RENDER_API_KEY: an account-level API key with permission to modify
# this service's env vars. Create one at Render -> Account Settings ->
# API Keys. Treat it like any other production secret -- do not commit
# it.
#
# RENDER_SERVICE_ID: Render sets this automatically in every service's
# environment at runtime, so it is normally already correct without
# being set here. Left blank/unset in local dev, where there is nothing
# to persist to anyway.
#
# GOOGLE_CALENDAR_REFRESH_TOKENS is deliberately NOT listed here to set
# by hand -- render_env_sync.py reads and writes it directly via
# Render's API, the same way BUSINESS_API_KEYS is set manually but this
# one is not.
RENDER_API_KEY=
RENDER_SERVICE_ID=
